{
  "uid": "hailpath-driver",
  "title": "Hailpath / Driver inspector",
  "description": "Lookup one driver_id: trail, status, speed, utilization.",
  "tags": [
    "hailpath",
    "live",
    "driver"
  ],
  "timezone": "America/New_York",
  "schemaVersion": 39,
  "version": 11,
  "refresh": "10s",
  "liveNow": true,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "driver_id",
        "label": "Driver",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "hailpath-clickhouse"
        },
        "definition": "SELECT DISTINCT toString(driver_id) FROM hailpath.driver_positions WHERE event_time >= now() - INTERVAL 1 HOUR ORDER BY 1 LIMIT 500",
        "query": "SELECT DISTINCT toString(driver_id) FROM hailpath.driver_positions WHERE event_time >= now() - INTERVAL 1 HOUR ORDER BY 1 LIMIT 500",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 0,
        "regex": "",
        "skipUrlSync": false,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Latest position",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "hailpath-clickhouse"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "hailpath-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    argMax(status, event_time) AS status,\n    argMax(lat, event_time) AS lat,\n    argMax(lon, event_time) AS lon,\n    argMax(speed_kmh, event_time) AS speed_kmh,\n    argMax(trip_id, event_time) AS trip_id\nFROM hailpath.driver_positions\nWHERE driver_id = '${driver_id}'\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Map trail",
      "type": "geomap",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "hailpath-clickhouse"
      },
      "description": "",
      "gridPos": {
        "h": 20,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "hailpath-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT event_time, lat, lon, status, speed_kmh, trip_id\nFROM hailpath.driver_positions\nWHERE driver_id = '${driver_id}'\n  AND $__timeFilter(event_time)\nORDER BY event_time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "allLayers": true,
          "id": "coords",
          "lat": 40.75,
          "lon": -73.98,
          "zoom": 11
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "xyz",
          "name": "Hailpath OSM",
          "config": {
            "url": "/tiles/styles/hailpath/{z}/{x}/{y}@2x.png",
            "attribution": "\u00a9 OpenStreetMap",
            "minZoom": 0,
            "maxZoom": 14
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Trail",
            "config": {
              "style": {
                "size": {
                  "fixed": 7,
                  "min": 3,
                  "max": 12
                },
                "color": {
                  "fixed": "dark-green"
                },
                "opacity": 0.9,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "tooltip": true
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Status over time",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "hailpath-clickhouse"
      },
      "description": "",
      "gridPos": {
        "h": 20,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "hailpath-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT event_time, status, speed_kmh, heading_deg, zone_id, trip_id, lat, lon\nFROM hailpath.driver_positions\nWHERE driver_id = '${driver_id}'\n  AND $__timeFilter(event_time)\nORDER BY event_time DESC\nLIMIT 15\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Speed",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "hailpath-clickhouse"
      },
      "description": "Straight from the device, as reported.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "hailpath-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT event_time AS time, speed_kmh\nFROM hailpath.driver_positions\nWHERE driver_id = '${driver_id}'\n  AND $__timeFilter(event_time)\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "Hourly utilization (busy / online ticks)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "hailpath-clickhouse"
      },
      "description": "Ticks spent on a trip out of ticks spent online. A share, so it is drawn as one - 0.42 is 42% of this driver's shift. h-bootstrap writes driver positions only along trip paths and only as on_trip, so the history has no idle telemetry and this reads 100% across the seeded window, then drops to the live figure. The cliff is the seam between seeded and live, not a collapse in efficiency.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "hailpath-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n    hour AS time,\n    sum(busy_ticks) / sum(online_ticks) AS utilization\nFROM hailpath.driver_utilization_hourly\nWHERE driver_id = '${driver_id}'\n  AND $__timeFilter(hour)\nGROUP BY hour\nHAVING sum(online_ticks) > 0\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.35
              },
              {
                "color": "green",
                "value": 0.55
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ],
  "links": [
