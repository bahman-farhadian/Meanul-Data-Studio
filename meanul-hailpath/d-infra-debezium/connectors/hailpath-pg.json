{
  "name": "hailpath-pg",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "filled in by register.py",
    "database.port": "filled in by register.py",
    "database.dbname": "filled in by register.py",
    "database.user": "filled in by register.py",
    "database.password": "filled in by register.py",

    "topic.prefix": "hailpath",
    "plugin.name": "pgoutput",
    "slot.name": "hailpath_debezium",
    "publication.name": "hailpath_pub",
    "publication.autocreate.mode": "filtered",

    "snapshot.mode": "initial",
    "table.include.list": "hailpath.drivers,hailpath.passengers,hailpath.trips,hailpath.city_zones,hailpath.vehicles,hailpath.trip_ratings,hailpath.driver_sessions",
    "column.exclude.list": "hailpath.trips.route",
    "tombstones.on.delete": "true",
    "heartbeat.interval.ms": "10000",

    "decimal.handling.mode": "double",
    "time.precision.mode": "connect",

    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "hailpath\\.hailpath\\.(.*)",
    "transforms.route.replacement": "cdc.$1",

    "topic.creation.enable": "true",
    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "3",
    "topic.creation.default.min.insync.replicas": "1",
    "topic.creation.default.cleanup.policy": "compact"
  }
}
