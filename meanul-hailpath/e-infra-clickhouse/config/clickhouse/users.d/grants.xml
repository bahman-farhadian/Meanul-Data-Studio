<?xml version="1.0"?>
<!--
  Product user may SELECT/INSERT/DDL on hailpath only. The image still
  writes users.d/default-user.xml with the password; this file restricts
  grants. default is localhost-only so a published 8123 cannot log in as
  the unnamed default user.
-->
<clickhouse>
    <users>
        <hailpath>
            <default_database>hailpath</default_database>
            <access_management>0</access_management>
            <grants>
                <query>GRANT SELECT, INSERT, ALTER, CREATE, DROP, TRUNCATE, SHOW ON hailpath.*</query>
            </grants>
        </hailpath>
        <default>
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>
    </users>
</clickhouse>
