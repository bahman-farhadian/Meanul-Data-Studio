# d-infra-debezium settings.
# Copy to .env (untracked) and set the password:  cp .env.example .env

# Everything in the stack runs in UTC (see the root README)
TZ=UTC

# Pinned images. Debezium publishes its own Connect image; the Avro
# converter is added on top of it at build time (see Dockerfile).
CONNECT_IMAGE=quay.io/debezium/connect:3.1
AVRO_CONVERTER_VERSION=8.0.0
PYTHON_IMAGE=python:3.13-slim

# Where Debezium reads from.
#
# lb-a always points at whichever PostgreSQL node is currently the leader,
# which is what a change-capture reader needs. Note the limitation: Debezium
# accepts one hostname only, so it cannot fail over from lb-a to lb-b by
# itself the way other clients do. If lb-a is ever lost, set CDC_PG_HOST to
# lb-b and run the connector-register one-shot again.
CDC_PG_HOST=lb-a
CDC_PG_PORT=5432
CDC_PG_DATABASE=postgres

# The database user Debezium logs in as. It must be allowed to read the
# write-ahead log, which the postgres superuser already is. It also creates
# the publication on first connect, which again needs a superuser.
CDC_PG_USER=postgres

# Must match PG_SUPERUSER_PASSWORD in a-infra-postgres/.env — CHANGE THIS
CDC_PG_PASSWORD=change-me
