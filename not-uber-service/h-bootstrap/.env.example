# h-bootstrap settings.
# Copy to .env (untracked):  cp .env.example .env
#
# The three passwords below MUST match the components they belong to, or
# bootstrap cannot connect and the whole stack stays waiting.

TZ=UTC
LOG_LEVEL=INFO

# --- PostgreSQL (piece a) ---------------------------------------------------
PG_HOST=nus-lb-a
PG_WRITE_PORT=5432
PG_READ_PORT=5433
PG_DATABASE=nus
PG_USER=postgres
# Same value as PG_SUPERUSER_PASSWORD in a-infra-postgres/.env
PG_PASSWORD=change-me
# Historical trips are routed through pgRouting, HISTORY_ROUTING_WORKERS at a
# time (below) - the pool needs at least that many connections plus some
# headroom for the rest of bootstrap's own queries.
PG_POOL_SIZE=16

# --- Redis (piece b) --------------------------------------------------------
REDIS_SENTINELS=nus-sentinel-1:26379,nus-sentinel-2:26379,nus-sentinel-3:26379
REDIS_MASTER_NAME=nus-cache
# Same value as REDIS_PASSWORD in b-infra-redis/.env
REDIS_PASSWORD=change-me-redis

# --- ClickHouse (piece e) ---------------------------------------------------
CH_HOST=nus-lb-a
CH_HTTP_PORT=8123
CH_DATABASE=nus
CH_USER=nus
# Same value as CH_PASSWORD in e-infra-clickhouse/.env
CH_PASSWORD=change-me-clickhouse

# --- The simulated city ------------------------------------------------------
# Nothing to set here: the city's zones are NYC TLC's own real Taxi Zones
# (TLC_ZONES_URL, above), not a configurable grid - see nus_common.citygrid.

# --- How much to create -----------------------------------------------------
# 1/10 of real NYC HVFHS scale (NYC TLC 2024 Annual Report: ~106,000
# licensed vehicles, ~655,000 trips/day) - the safe default for a laptop.
# Dionysus's own .env carries the full-scale numbers instead: roughly
# SEED_DRIVERS=106000, SEED_PASSENGERS=1500000, HISTORY_TRIPS_PER_DAY=655000,
# HISTORY_ROUTING_WORKERS=16-20 (a Ryzen 3900X has 12 physical cores).
SEED_DRIVERS=10000
SEED_PASSENGERS=150000
HISTORY_DAYS=7
HISTORY_TRIPS_PER_DAY=65000
# Position reports kept per historical trip. Real devices report far more
# often; a week of that would be tens of millions of rows.
HISTORY_POSITIONS_PER_TRIP=8
# Historical trips are routed for real, through the same pgRouting query
# dispatch-service uses live. This many route lookups run at once - a
# CPU-bound workload, so this tracks physical cores, not thread count.
HISTORY_ROUTING_WORKERS=16
# How far nus_common.routing.nearest_road_point() will snap a candidate
# point to the road network before giving up and calling it off the map
# (open water, a park, a real island with no car bridge).
MAX_SNAP_KM=0.5

# --- Prices -----------------------------------------------------------------
# Used for the historical week, and by dispatch-service for live trips, so
# both quote the same way.
FARE_BASE=3.0
FARE_PER_KM=1.75
FARE_PER_MINUTE=0.45
PLATFORM_COMMISSION_PCT=0.20

# --- The map ----------------------------------------------------------------
# NYC's own official LION street data (DCP) - DOT-verified one-way
# directions and posted speed limits, not OpenStreetMap. `make lion-fetch`
# and `make lion-prepare` (both part of `make prepare`) build the routable
# graph on the host, once; this container only restores it.
LION_URL=https://data.cityofnewyork.us/download/2v4z-66xt/application/zip
# NYC TLC's real, official Taxi Zones - the same 263 zones Uber/Lyft/yellow
# cabs actually report trips against, not a synthetic grid. `make
# tlc-zones-fetch` and `make lion-prepare` (both part of `make prepare`)
# build city_zones_source from it on the host, once.
TLC_ZONES_URL=https://data.cityofnewyork.us/api/geospatial/8meu-9t5y?method=export&format=GeoJSON
LION_PG_PASSWORD=throwaway-local-only
LION_PG_IMAGE=postgis/postgis:17-3.5

# Set to true to skip restoring the graph entirely. Useful for a quick run
# while working on something else - but routing will not work without it.
SKIP_MAP_IMPORT=false

# Set to true to run the preparation steps again on a stack that has already
# been prepared. Off by default so an accidental restart does nothing.
FORCE_RESEED=false
