# o-service-archiver settings.
# Copy to .env (untracked):  cp .env.example .env

TZ=UTC
LOG_LEVEL=INFO

# Redis (piece b) — only used for the standard bootstrap-done check every
# service waits on. Password must match b-infra-redis/.env
REDIS_SENTINELS=nus-sentinel-1:26379,nus-sentinel-2:26379,nus-sentinel-3:26379
REDIS_MASTER_NAME=nus-cache
REDIS_PASSWORD=change-me-redis

# PostgreSQL (piece a) — password must match a-infra-postgres/.env
PG_HOST=nus-lb-a
PG_WRITE_PORT=5432
PG_READ_PORT=5433
PG_DATABASE=nus
PG_USER=postgres
PG_PASSWORD=change-me

# How often a prune pass runs.
ARCHIVER_TICK_MINUTES=15.0

# How long a finished trip (ended_at set - completed, cancelled either way,
# or no_driver_found) stays in Postgres before being pruned. trip_events
# (e-infra-clickhouse) already has it durably well before this - see
# archiver_service/__main__.py's own docstring for why 24 hours is a real
# margin, not a race.
ARCHIVER_RETENTION_HOURS=24

# Trips deleted per batch, and a ceiling on how many batches one tick runs -
# a real backlog just takes more ticks, rather than one tick running
# forever and starving its own timer.
ARCHIVER_BATCH_SIZE=5000
ARCHIVER_MAX_BATCHES_PER_TICK=20
