# Stack-wide settings (lb-a / lb-b entry tier).
# Copy to .env (untracked) and adjust as needed:  cp .env.example .env

# Timezone policy: every container in the stack runs UTC. The only
# non-UTC notion anywhere is the simulation pacing config, interpreted in
# SIM_TIMEZONE (consumed by the generator services when they land).
TZ=UTC
SIM_TIMEZONE=America/New_York

# HAProxy image (pinned)
HAPROXY_IMAGE=haproxy:3.4.0

# Host ports published by lb-a (canonical entry point)
LB_A_PG_WRITE_PORT=5432
LB_A_PG_READ_PORT=5433
LB_A_STATS_PORT=8404
# Enabled as the corresponding components land:
# LB_A_CH_HTTP_PORT=8123
# LB_A_CH_NATIVE_PORT=9000
# LB_A_GRAFANA_PORT=3000
# LB_A_SUPERSET_PORT=8088

# Host ports published by lb-b (failover twin; alternate ports because a
# single host cannot bind the same port twice)
LB_B_PG_WRITE_PORT=15432
LB_B_PG_READ_PORT=15433
LB_B_STATS_PORT=18404
# LB_B_CH_HTTP_PORT=18123
# LB_B_CH_NATIVE_PORT=19000
# LB_B_GRAFANA_PORT=13000
# LB_B_SUPERSET_PORT=18088
