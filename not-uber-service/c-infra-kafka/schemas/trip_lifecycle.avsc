{
  "type": "record",
  "name": "TripLifecycle",
  "namespace": "nus.events",
  "doc": "One status change of one trip. A trip normally walks requested -> matched -> accepted -> en_route_pickup -> arrived -> in_progress -> completed, and can end early in one of the three cancel states. Keyed by trip_id, so the whole story of a trip stays in order on one partition.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "Unique id of this message, a UUID4 minted by the producer. The sink refuses an event_id it has already written - ClickHouse does not deduplicate on its own, so uniqueness has to hold before the warehouse. Plain string rather than the uuid logical type on purpose: fastavro decodes that one into a UUID object, which json.dumps cannot write into Redis."},
    {"name": "event_version", "type": "int", "default": 1, "doc": "Version of this record's shape. Bumped when an existing field changes meaning, not when a new one is added - adding is what the Registry's own compatibility rules already cover."},
    {"name": "producer", "type": "string", "doc": "Which service sent this: driver-service, passenger-service, dispatch-service, city-service or bootstrap. The first question asked when a stream looks wrong is who wrote it."},
    {"name": "correlation_id", "type": ["null", "string"], "default": null, "doc": "Ties every message belonging to one trip together across topics - the trip_id on trip-scoped streams, null when the message belongs to no trip."},
    {"name": "trip_id", "type": "string"},
    {"name": "rider_id", "type": "string"},
    {"name": "driver_id", "type": ["null", "string"], "default": null, "doc": "Empty until a driver has been matched."},
    {"name": "status", "type": {"type": "enum", "name": "TripStatus", "symbols": ["requested", "matched", "accepted", "en_route_pickup", "in_progress", "completed", "cancelled_by_passenger", "cancelled_by_driver", "no_driver_found", "arrived"]}, "doc": "The status the trip has just entered. 'arrived' is appended at the end, out of lifecycle order, because the ClickHouse copy of this set is an Enum8 with explicit numbers - inserting it in its natural place would renumber every symbol after it and reinterpret rows already on disk."},
    {"name": "pickup_zone_id", "type": ["null", "string"], "default": null},
    {"name": "dropoff_zone_id", "type": ["null", "string"], "default": null},
    {"name": "passenger_count", "type": "int", "default": 1, "doc": "How many people are travelling. Carried through from the request so the warehouse can see party size, which decides whether a tier was a preference or a capacity constraint."},
    {"name": "requested_vehicle_type", "type": {"type": "enum", "name": "VehicleType", "symbols": ["economy", "xl", "premium"]}, "default": "economy", "doc": "The tier the rider asked for. In Postgres since 006 and matched on by dispatch, but never carried to the warehouse until now - so nothing downstream could group by tier."},
    {"name": "route_km", "type": ["null", "double"], "default": null, "doc": "Length of the route pgRouting computed at assignment time."},
    {"name": "predicted_duration_s", "type": ["null", "int"], "default": null, "doc": "How long the route was expected to take, given the traffic factors at that moment."},
    {"name": "actual_duration_s", "type": ["null", "int"], "default": null, "doc": "How long it really took. Only set when the trip ends."},
    {"name": "surge_multiplier", "type": ["null", "double"], "default": null, "doc": "Price multiplier taken from the pickup zone's demand score at request time. Stays a double, unlike the money fields below: it is a ratio, not an amount, and nothing sums it."},
    {"name": "fare_estimate", "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 10, "scale": 2}], "default": null, "doc": "Price quoted at assignment. decimal(10,2), matching trips.fare_estimate's numeric(10,2) in Postgres and Decimal64(2) in ClickHouse - one representation end to end, with no double hop in the middle. fastavro refuses a float here, which is what makes that impossible to forget."},
    {"name": "fare_final", "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 10, "scale": 2}], "default": null, "doc": "Price charged at completion, with the time part recomputed from the real duration."},
    {"name": "driver_payout", "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 10, "scale": 2}], "default": null, "doc": "What the driver took home. With fare_final this is the platform take rate - the single most important marketplace number, and unanswerable in the warehouse until this field existed."},
    {"name": "payment_method", "type": ["null", {"type": "enum", "name": "PaymentMethod", "symbols": ["card", "wallet", "cash"]}], "default": null, "doc": "How the rider paid. Set at completion."},
    {"name": "cancellation_reason", "type": ["null", {"type": "enum", "name": "CancellationReason", "symbols": ["rider_no_show", "driver_too_far", "vehicle_issue", "changed_mind", "found_alternative", "wait_too_long"]}], "default": null, "doc": "Why, within cancelled_by_driver / cancelled_by_passenger. Support and analytics need to tell 'rider never showed up' apart from 'driver found something better' - very different problems that look identical without this."},
    {"name": "requested_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "Milestone timestamps, carried from the trips row rather than reconstructed downstream from when each event happened to arrive. They make the terminal event a complete account of the trip, which is what lets the warehouse keep one plain row per trip instead of six event rows and a self-join. Set on every message the producer has them for; on a request-time message only this one is known."},
    {"name": "matched_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "When dispatch picked a candidate. requested_at to here is time-to-match."},
    {"name": "accepted_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "When a driver took the offer."},
    {"name": "arrived_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "When the driver reached the pickup point. Rider wait at pickup is the gap between this and the start of the trip, and a cancellation counts as post-arrival exactly when this is set."},
    {"name": "started_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "When the rider got in and the trip began."},
    {"name": "ended_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "When the trip reached a terminal state, whether completed or cancelled."},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When the status change happened. Always UTC."}
  ]
}
