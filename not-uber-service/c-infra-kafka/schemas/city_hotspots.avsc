{
  "type": "record",
  "name": "CityHotspot",
  "namespace": "nus.events",
  "doc": "How busy one city zone is in one part of the day, as computed by city-service from the live streams. Drivers are guided towards high scores, and the same score sets the surge price for trips starting in that zone.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "Unique id of this message, a UUID4 minted by the producer. The sink refuses an event_id it has already written - ClickHouse does not deduplicate on its own, so uniqueness has to hold before the warehouse. Plain string rather than the uuid logical type on purpose: fastavro decodes that one into a UUID object, which json.dumps cannot write into Redis."},
    {"name": "event_version", "type": "int", "default": 1, "doc": "Version of this record's shape. Bumped when an existing field changes meaning, not when a new one is added - adding is what the Registry's own compatibility rules already cover."},
    {"name": "producer", "type": "string", "doc": "Which service sent this: driver-service, passenger-service, dispatch-service, city-service or bootstrap. The first question asked when a stream looks wrong is who wrote it."},
    {"name": "correlation_id", "type": ["null", "string"], "default": null, "doc": "Ties every message belonging to one trip together across topics - the trip_id on trip-scoped streams, null when the message belongs to no trip."},
    {"name": "zone_id", "type": "string", "doc": "The city zone this score is about."},
    {"name": "period", "type": {"type": "enum", "name": "DayPeriod", "symbols": ["night", "morning", "afternoon", "evening"]}, "doc": "Which six-hour part of the day the score belongs to. The day is split into four."},
    {"name": "demand_score", "type": "double", "doc": "Demand against supply in this zone, normalised to roughly 0..1. Higher means more riders per free driver."},
    {"name": "open_requests", "type": "int", "doc": "Ride requests in the zone that had no driver yet when the score was computed."},
    {"name": "available_drivers", "type": "int", "doc": "Free drivers inside the zone at that moment."},
    {"name": "surge_multiplier", "type": "double", "doc": "Price multiplier derived from demand_score. 1.0 means normal price."},
    {"name": "computed_at", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When city-service computed this score. Always UTC."}
  ]
}
