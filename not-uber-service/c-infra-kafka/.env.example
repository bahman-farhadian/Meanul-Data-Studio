# c-infra-kafka settings.
# Copy to .env (untracked):  cp .env.example .env

# Everything in the stack runs in UTC (see the root README)
TZ=UTC

# Pinned images. apache/kafka speaks KRaft natively. Schema Registry and
# ksqlDB come from Confluent because the Apache project does not ship them.
KAFKA_IMAGE=apache/kafka:4.3.1
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:8.3.1
KSQLDB_IMAGE=confluentinc/cp-ksqldb-server:8.3.1
BUSYBOX_IMAGE=busybox:1.38.0

# ksqlDB's HTTP Basic auth. This is how a SQL client reads Kafka.
# CHANGE THE PASSWORD; must not contain ':' or ','.
KSQLDB_ADMIN_USER=admin
KSQLDB_ADMIN_PASSWORD=change-me-ksqldb

# The broker's cluster id.
#
# In KRaft there is no ZooKeeper to hand out an identity, so the broker gets
# one at format time and keeps it forever. Never change it once the data
# volume exists - a volume that says "cluster A" refuses to start as
# "cluster B".
# Generate your own with:  docker run --rm apache/kafka:4.3.1 \
#   /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=2DgQxcGwSsWn1QTQzKeEFg

# The user inside the Kafka image. The kafka-dirs one-shot hands the data
# volumes to this user before the first start, because a new Docker volume
# belongs to root and the broker does not run as root.
# Check the real values with:  docker run --rm apache/kafka:4.3.1 id
KAFKA_UID=1000
KAFKA_GID=1000

# How long messages are kept before Kafka deletes them. Two days is enough
# for a consumer to be restarted, fixed, and replayed, without letting the
# disk grow without limit. ClickHouse is where history lives.
KAFKA_RETENTION_HOURS=48
