# a-infra-postgres settings.
# Copy to .env (untracked) and change the passwords:  cp .env.example .env

# Pinned base image for the Patroni node build
PG_IMAGE=postgres:18.4

# etcd DCS image
ETCD_IMAGE=quay.io/coreos/etcd:v3.6.5

# Patroni cluster name (scope)
PATRONI_SCOPE=nus-pg

# Secrets — CHANGE THESE
PG_SUPERUSER_PASSWORD=change-me
PG_REPLICATION_PASSWORD=change-me-too
