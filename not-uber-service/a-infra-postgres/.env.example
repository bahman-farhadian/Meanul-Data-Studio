# a-infra-postgres settings.
# Copy to .env (untracked) and change the passwords:  cp .env.example .env
# Non-secret etcd cluster settings live in etcd.env (committed).

# Everything in the stack runs in UTC (see the root README)
TZ=UTC

# Pinned images
PG_IMAGE=postgres:18.4
ETCD_IMAGE=quay.io/coreos/etcd:v3.6.12
OPENSSL_IMAGE=alpine/openssl:3.3.2

# Patroni cluster name ("nus" = not-uber-service)
PATRONI_SCOPE=nus-pg

# Patroni REST API credentials — protect switchover/restart/reload
# endpoints; monitoring GETs stay open for the HAProxy health checks.
PATRONI_REST_USER=patroni
PATRONI_REST_PASSWORD=change-me-rest

# PostgreSQL secrets — CHANGE THESE
PG_SUPERUSER_PASSWORD=change-me
PG_REPLICATION_PASSWORD=change-me-too
