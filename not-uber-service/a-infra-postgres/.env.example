# a-infra-postgres settings.
# Copy to .env (untracked) and change the password:  cp .env.example .env

TZ=UTC

PG_IMAGE=pgrouting/pgrouting:18-3.6-3.8.0
NUS_VERSION=0.1.0

# PostgreSQL superuser. Created on first start. Used by bootstrap, the
# services, and Debezium.
PG_SUPERUSER_PASSWORD=change-me
PG_DATABASE=nus
