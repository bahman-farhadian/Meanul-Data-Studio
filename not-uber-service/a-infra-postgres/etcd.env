# nus-etcd — the stack's shared 3-node etcd cluster ("nus" =
# not-uber-service). Patroni uses it as its DCS; any future component that
# needs an etcd/KV store reuses THIS cluster — never deploy a second one.
#
# Shared settings for all three nodes; per-node values (ETCD_NAME and the
# advertise URLs) are set in docker-compose.yaml. No secrets live here, so
# this file is committed.

# IMPORTANT — cluster lifecycle:
#   'new'      only for the very first bootstrap of an empty cluster.
#   'existing' after the first successful start (the data volumes exist).
# Flip this to 'existing' once the cluster has bootstrapped.
ETCD_INITIAL_CLUSTER_STATE=existing

ETCD_INITIAL_CLUSTER_TOKEN=nus-etcd
ETCD_INITIAL_CLUSTER=etcd-1=https://etcd-1:2380,etcd-2=https://etcd-2:2380,etcd-3=https://etcd-3:2380

ETCD_DATA_DIR=/etcd-data
ETCD_LISTEN_CLIENT_URLS=https://0.0.0.0:2379
ETCD_LISTEN_PEER_URLS=https://0.0.0.0:2380

# TLS — material auto-generated by the etcd-certgen one-shot (10-year
# validity, SANs for etcd-1/2/3 + localhost). Client AND peer connections
# require certificates signed by the cluster CA.
ETCD_CERT_FILE=/certs/server.crt
ETCD_KEY_FILE=/certs/server.key
ETCD_TRUSTED_CA_FILE=/certs/ca.crt
ETCD_CLIENT_CERT_AUTH=true
ETCD_PEER_CERT_FILE=/certs/server.crt
ETCD_PEER_KEY_FILE=/certs/server.key
ETCD_PEER_TRUSTED_CA_FILE=/certs/ca.crt
ETCD_PEER_CLIENT_CERT_AUTH=true
