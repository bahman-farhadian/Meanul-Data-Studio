# m-service-city settings.
# Copy to .env (untracked):  cp .env.example .env

TZ=UTC
LOG_LEVEL=INFO

# Kafka and the Schema Registry (piece c)
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_GROUP_ID=city-service

# Redis (piece b) — password must match b-infra-redis/.env
REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
REDIS_MASTER_NAME=nus-cache
REDIS_PASSWORD=change-me-redis

# PostgreSQL (piece a) — password must match a-infra-postgres/.env
PG_HOST=lb-a
PG_WRITE_PORT=5432
PG_READ_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=change-me

# The city. Must be the same everywhere.
CITY_MIN_LAT=40.49
CITY_MAX_LAT=40.92
CITY_MIN_LON=-74.26
CITY_MAX_LON=-73.70
CITY_GRID_ROWS=6
CITY_GRID_COLS=6

# --- The two clocks ---------------------------------------------------------
# How often demand scores are published. Short, because drivers and prices
# read them: a stale score sends cars to yesterday's rush.
CITY_SCORE_SECONDS=30.0

# How often the routing costs in PostgreSQL are refreshed. Far longer,
# because that query touches every road segment inside a zone.
CITY_TRAFFIC_UPDATE_MINUTES=5.0

# How long a demand score stays valid in Redis. Six hours is the length of
# one part of the day, so a score cannot outlive the period it describes -
# and a stopped city-service cannot leave stale scores behind for ever.
HOTSPOT_TTL_SECONDS=21600

# The score at which a zone counts as a hotspot. Used for the log line and,
# in the sink, to mark a trip as a hotspot trip.
HOTSPOT_SCORE_THRESHOLD=0.6
