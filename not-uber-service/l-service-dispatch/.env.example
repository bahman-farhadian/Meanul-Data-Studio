# l-service-dispatch settings.
# Copy to .env (untracked):  cp .env.example .env

TZ=UTC
LOG_LEVEL=INFO

# Kafka and the Schema Registry (piece c)
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
DISPATCH_GROUP_ID=dispatch-service

# Redis (piece b) — password must match b-infra-redis/.env
REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
REDIS_MASTER_NAME=nus-cache
REDIS_PASSWORD=change-me-redis

# PostgreSQL (piece a) — password must match a-infra-postgres/.env
PG_HOST=lb-a
PG_WRITE_PORT=5432
PG_READ_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=change-me

# The city. Must be the same everywhere.
CITY_MIN_LAT=40.49
CITY_MAX_LAT=40.92
CITY_MIN_LON=-74.26
CITY_MAX_LON=-73.70
CITY_GRID_ROWS=6
CITY_GRID_COLS=6

# --- Prices -----------------------------------------------------------------
# fare = (base + per_km x kilometres + per_minute x minutes) x surge
# The same three numbers h-bootstrap used, so live trips are priced the way
# the seeded history was.
FARE_BASE=3.0
FARE_PER_KM=1.75
FARE_PER_MINUTE=0.45

# --- Matching ---------------------------------------------------------------
# How often the service looks for new work. One second keeps a rider's wait
# short without spinning the loop for nothing.
DISPATCH_TICK_SECONDS=1.0
# How far to look for a free driver. Widening this finds a driver more often
# and sends them further, which riders feel as a longer wait.
DISPATCH_SEARCH_RADIUS_KM=5.0
# A ceiling per tick, so a burst of requests cannot turn one tick into a
# minute of routing queries.
DISPATCH_MAX_REQUESTS_PER_TICK=50

# --- How trips fall apart ---------------------------------------------------
# Real trips do not all finish. These two, plus "nobody was available", are
# what makes the completed share land near 70 percent.
CANCEL_BY_DRIVER_CHANCE=0.06
CANCEL_BY_PASSENGER_CHANCE=0.07

# How long a live trip entry may stay in Redis. Only a safety net: a trip
# that ends normally deletes its own entry.
TRIP_ACTIVE_TTL_SECONDS=7200

RANDOM_SEED=20250824
