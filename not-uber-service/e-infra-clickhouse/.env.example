# e-infra-clickhouse settings.
# Copy to .env (untracked) and change the password:  cp .env.example .env

# Everything in the stack runs in UTC (see the root README)
TZ=UTC

# Pinned images, both from the ClickHouse project itself. Server and Keeper
# must always be the same version.
CH_SERVER_IMAGE=clickhouse/clickhouse-server:26.8.2.7
CH_KEEPER_IMAGE=clickhouse/clickhouse-keeper:26.8.2.7

# The login every client uses: clickhouse-sink, Grafana, Superset, and the
# one-shot that creates the tables. The image creates this user on first
# start, so no password is written into a file in this repository.
CH_USER=nus
CH_PASSWORD=change-me-clickhouse
