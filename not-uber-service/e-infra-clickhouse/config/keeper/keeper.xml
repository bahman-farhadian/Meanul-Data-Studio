<?xml version="1.0"?>
<!--
  ClickHouse Keeper - the part that lets the ClickHouse nodes agree with each
  other. It answers questions like "which replica has the newest data" and
  "who is allowed to merge this part right now".

  All three Keeper nodes share this one file. The only thing that differs per
  node is server_id, which is read from the environment, so there is no
  copy of this file to keep in step.

  Three nodes means the group keeps working while one is down: two out of
  three is still a majority.
-->
<clickhouse>
    <logger>
        <level>information</level>
        <!-- Empty paths send the log to the container output, so
             `docker compose logs` is the single place to look. -->
        <console>1</console>
    </logger>

    <listen_host>0.0.0.0</listen_host>

    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id from_env="KEEPER_SERVER_ID"/>
        <log_storage_path>/var/lib/clickhouse-keeper/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse-keeper/coordination/snapshots</snapshot_storage_path>

        <!-- Allow the tiny text commands used by the health check, such as
             sending "ruok" and reading back "imok". -->
        <four_letter_word_white_list>ruok,mntr,stat,srvr,conf</four_letter_word_white_list>

        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>

        <!-- Every member of the group, listed the same way on every node. -->
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>ch-keeper-1</hostname>
                <port>9234</port>
            </server>
            <server>
                <id>2</id>
                <hostname>ch-keeper-2</hostname>
                <port>9234</port>
            </server>
            <server>
                <id>3</id>
                <hostname>ch-keeper-3</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
</clickhouse>
