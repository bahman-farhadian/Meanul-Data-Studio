# j-service-driver settings.
# Copy to .env (untracked):  cp .env.example .env

TZ=UTC
LOG_LEVEL=INFO

# Kafka and the Schema Registry (piece c)
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_GROUP_ID=driver-service

# Redis (piece b) — password must match b-infra-redis/.env
REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
REDIS_MASTER_NAME=nus-cache
REDIS_PASSWORD=change-me-redis

# PostgreSQL (piece a) — password must match a-infra-postgres/.env
PG_HOST=lb-a
PG_WRITE_PORT=5432
PG_READ_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=change-me

# The city. Must be the same everywhere, or two components would draw
# different maps and disagree about which zone a point is in.
CITY_MIN_LAT=40.49
CITY_MAX_LAT=40.92
CITY_MIN_LON=-74.26
CITY_MAX_LON=-73.70
CITY_GRID_ROWS=6
CITY_GRID_COLS=6

# --- The main volume dial of the whole stack --------------------------------
# One position report per online driver per tick. With 800 drivers, a 0.6
# online share and a 3 second tick that is about 160 messages a second.
# Halving the tick doubles the load on Kafka, ClickHouse and the sink.
DRIVER_TICK_SECONDS=3.0
DRIVER_SPEED_KMH=25.0
DRIVER_ONLINE_SHARE=0.6
# Chance per driver per tick of starting or ending a shift.
DRIVER_SHIFT_CHANGE_CHANCE=0.01
# How often the last known state is written to PostgreSQL.
DRIVER_DB_SYNC_SECONDS=30.0
# How often drivers look up which zones are busy.
DRIVER_HOTSPOT_REFRESH_SECONDS=60.0

# Same seed, same fleet behaviour - a run that can be repeated can be
# debugged.
RANDOM_SEED=20250824
