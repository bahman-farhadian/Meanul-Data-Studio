# b-infra-redis settings.
# Copy to .env (untracked) and change the password:  cp .env.example .env

# Everything in the stack runs in UTC (see the root README)
TZ=UTC

# Pinned image — one image serves both roles (redis-sentinel ships with it)
REDIS_IMAGE=redis:8.2

# Sentinel's name for the monitored set ("nus" = not-uber-service). Clients
# ask Sentinel for THIS name to find the current primary.
REDIS_MASTER_NAME=nus-cache

# Seed primary of a cold start only. Once Sentinel has run a failover, the
# live topology lives in each node's own config on its volume, and this value
# is ignored on restart.
REDIS_MASTER_HOST=redis-1

# Redis secret — CHANGE THIS. Used as requirepass on the data nodes,
# masterauth between them, and sentinel auth-pass. Sentinel itself is
# unauthenticated (internal network only, no host ports) — see README.
REDIS_PASSWORD=change-me-redis

# Dataset ceiling per node, deliberately below the 4 GB container limit: an
# AOF-rewrite fork copies dirty pages and there is no swap to absorb it.
REDIS_MAXMEMORY=2560mb

# Sentinel failover tuning. Quorum 2 of 3 sentinels must agree the primary is
# down; down-after is how long it must look down first.
SENTINEL_QUORUM=2
SENTINEL_DOWN_AFTER_MS=5000
SENTINEL_FAILOVER_TIMEOUT_MS=15000
