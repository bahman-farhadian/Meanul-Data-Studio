# b-infra-redis settings.
# Copy to .env (untracked) and change the password:  cp .env.example .env

# Everything in the stack runs in UTC (see the root README)
TZ=UTC

REDIS_IMAGE=redis:8.10.1

# Redis secret — CHANGE THIS. Used as requirepass.
REDIS_PASSWORD=change-me-redis

# Dataset ceiling, deliberately below the 4 GB container limit: an
# AOF-rewrite fork copies dirty pages and there is no swap to absorb it.
REDIS_MAXMEMORY=2560mb
