# nus-lb-a / nus-lb-b — stack-wide active-passive HAProxy pair.
# Identical config on both instances; clients list both (nus-lb-a,nus-lb-b)
# and fail over client-side. Backends resolve through Docker's embedded DNS
# (127.0.0.11) with init-addr none, so HAProxy starts cleanly even while
# a backend's containers do not exist yet.
#
# THIS IS A TEMPLATE, not the file HAProxy reads. __REDIS_PASSWORD__ below
# is filled in by the render-haproxy-config one-shot before lb-a/lb-b start
# (HAProxy does not expand ${VAR} from its own environment inside a
# tcp-check string — confirmed, not assumed) — see
# z-config/haproxy/render-config.sh. Never put a real password in this
# file; it is committed.

global
    log stdout format raw local0 info
    maxconn 4096

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client 30m
    timeout server 30m
    default-server resolvers docker init-addr last,libc,none inter 3s fall 3 rise 2

resolvers docker
    nameserver dns1 127.0.0.11:53
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s
    hold valid 10s
    hold other 10s
    hold refused 10s
    hold nx 10s
    hold timeout 10s
    hold obsolete 10s

# Stats / observability ------------------------------------------------------
listen stats
    mode http
    bind :8404
    stats enable
    stats uri /stats
    stats refresh 10s

# PostgreSQL (a-infra-postgres) ----------------------------------------------
# Patroni's REST API (port 8008) answers 200 on /primary only on the current
# leader and 200 on /replica only on healthy replicas, so HAProxy always
# routes writes to the leader and reads to the replica pool — across
# failovers, automatically.
#
# The checks use OPTIONS (as in Patroni's official HAProxy template), not
# GET: Patroni answers OPTIONS with the status line only, so HAProxy's
# early socket close cannot interrupt a body write — with GET, every probe
# spams the Patroni logs with ConnectionResetError tracebacks.
# on-marked-down shutdown-sessions kills connections pinned to a
# demoted leader the moment its check fails, forcing clients to reconnect
# to the new one.

listen pg_write
    bind :5432
    option httpchk
    http-check send meth OPTIONS uri /primary
    http-check expect status 200
    default-server on-marked-down shutdown-sessions
    server nus-pg-1 nus-pg-1:5432 check port 8008
    server nus-pg-2 nus-pg-2:5432 check port 8008
    server nus-pg-3 nus-pg-3:5432 check port 8008

listen pg_read
    bind :5433
    balance roundrobin
    option httpchk
    http-check send meth OPTIONS uri /replica
    http-check expect status 200
    default-server on-marked-down shutdown-sessions
    server nus-pg-1 nus-pg-1:5432 check port 8008
    server nus-pg-2 nus-pg-2:5432 check port 8008
    server nus-pg-3 nus-pg-3:5432 check port 8008

# Redis (b-infra-redis) --------------------------------------------------------
# Unlike Postgres, Redis was deliberately NOT proxied for a long time: a naive
# TCP passthrough would keep routing to a node Sentinel had already demoted.
# This check is role-aware instead, the same idea as pg_write/pg_read: it
# authenticates, sends INFO replication, and only routes to a node whose own
# answer matches the role this backend wants. A demoted node also refuses
# writes on its own (Redis's replica-read-only default), so the few seconds
# while a check is catching up after a failover cannot cause a stray write to
# land on the wrong node — it is rejected there, not silently accepted.
#
# REDIS_PASSWORD must not contain whitespace: AUTH is sent as a raw inline
# Redis command here, which splits on spaces.

listen redis_write
    bind :6379
    option tcp-check
    tcp-check send AUTH\ __REDIS_PASSWORD__\r\n
    tcp-check expect string +OK
    tcp-check send PING\r\n
    tcp-check expect string +PONG
    tcp-check send info\ replication\r\n
    tcp-check expect string role:master
    tcp-check send QUIT\r\n
    tcp-check expect string +OK
    default-server on-marked-down shutdown-sessions
    server nus-redis-1 nus-redis-1:6379 check
    server nus-redis-2 nus-redis-2:6379 check
    server nus-redis-3 nus-redis-3:6379 check

listen redis_read
    bind :6380
    balance roundrobin
    option tcp-check
    tcp-check send AUTH\ __REDIS_PASSWORD__\r\n
    tcp-check expect string +OK
    tcp-check send PING\r\n
    tcp-check expect string +PONG
    tcp-check send info\ replication\r\n
    tcp-check expect string role:slave
    tcp-check send QUIT\r\n
    tcp-check expect string +OK
    default-server on-marked-down shutdown-sessions
    server nus-redis-1 nus-redis-1:6379 check
    server nus-redis-2 nus-redis-2:6379 check
    server nus-redis-3 nus-redis-3:6379 check

# Kafka (c-infra-kafka) --------------------------------------------------------
# Not a write/read pair like everything above: a Kafka client asks any broker
# for cluster metadata, which hands back the exact address to dial for every
# partition after that, baked into each broker's own advertised.listeners at
# startup — nothing a proxy can redirect per-request. So this is one dedicated
# TCP passthrough port per (broker, external address) pair; balance/role-
# awareness would be meaningless here since every broker is a different,
# specific destination, not an interchangeable one.
#
# Two addresses (A/B) per broker because this host has more than one real
# network path to it and a broker can only advertise one address per listener
# name — see c-infra-kafka/docker-compose.yaml for the mechanism, verified
# against a real cluster before this shipped: producing through one broker's
# port and consuming through a different broker's port, and separately,
# producing through address A and consuming through address B, both worked.
#
# lb-a only, deliberately: lb-a/lb-b failover doesn't compose with an address
# fixed at broker startup the way it does for a role-aware health check
# elsewhere in this file. The cluster's own bootstrap-list fallback is
# Kafka's actual redundancy story.

listen kafka-1-a
    bind :9094
    server nus-kafka-1 nus-kafka-1:9094 check

listen kafka-2-a
    bind :9095
    server nus-kafka-2 nus-kafka-2:9094 check

listen kafka-3-a
    bind :9096
    server nus-kafka-3 nus-kafka-3:9094 check

listen kafka-1-b
    bind :9097
    server nus-kafka-1 nus-kafka-1:9095 check

listen kafka-2-b
    bind :9098
    server nus-kafka-2 nus-kafka-2:9095 check

listen kafka-3-b
    bind :9099
    server nus-kafka-3 nus-kafka-3:9095 check

# ksqlDB (c-infra-kafka) -------------------------------------------------------
# The SQL layer over the cluster above: DBeaver's own Kafka support only
# speaks ksqlDB's REST API, not the raw broker protocol the six ports above
# use. One backend, so this is the same single-entry-point pattern as
# Grafana/Superset below, not the per-broker passthrough above it — ksqlDB
# is one stateless server, not something with a per-node advertised address.
#
# ksqlDB requires HTTP Basic auth (Kafka itself has none, and DBeaver's
# ksqlDB driver requires a login regardless), so the healthcheck below must
# authenticate too or every probe gets 401 and the backend never comes up.
# __KSQLDB_BASIC_AUTH__ is base64(user:pass), filled in by the same render
# step as __REDIS_PASSWORD__ above — see render-config.sh. A real client's
# own Authorization header passes straight through this proxy unchanged;
# this header is only for HAProxy's own probe.

listen ksqldb
    bind :8089
    option httpchk
    http-check send meth GET uri /info hdr Authorization "Basic __KSQLDB_BASIC_AUTH__"
    http-check expect status 200
    server nus-ksqldb-server nus-ksqldb-server:8088 check

# Debezium Connect (d-infra-debezium) ------------------------------------------
# One backend, no authentication (Connect's REST API has none, and the raw
# Kafka ports it depends on have none either - same trust model as ksqlDB's
# own underlying cluster, just without ksqlDB's one login). The check mirrors
# Connect's own container healthcheck: GET / answers 200 once it is actually
# serving, not merely running - this image scans every bundled connector
# plugin before it opens the REST port, which is measured to take minutes,
# not seconds.

listen debezium
    bind :8083
    option httpchk
    http-check send meth GET uri /
    http-check expect status 200
    server nus-debezium-connect nus-debezium-connect:8083 check

# ClickHouse (e-infra-clickhouse) ---------------------------------------------
# All four nodes are equal here: any of them can answer any query, because a
# Distributed table sends the work to the shard that owns the rows. So this is
# a plain round-robin over whoever is healthy, unlike the PostgreSQL backends
# above where the role decides who gets the traffic.
#
# The HTTP check asks for /ping, which ClickHouse answers with "Ok." without
# needing a login. The native port has no such endpoint, so it is checked by
# opening a connection.

listen ch_http
    bind :8123
    balance roundrobin
    option httpchk
    http-check send meth GET uri /ping
    http-check expect status 200
    server nus-ch-s1r1 nus-ch-s1r1:8123 check
    server nus-ch-s1r2 nus-ch-s1r2:8123 check
    server nus-ch-s2r1 nus-ch-s2r1:8123 check
    server nus-ch-s2r2 nus-ch-s2r2:8123 check

listen ch_native
    bind :9000
    balance roundrobin
    server nus-ch-s1r1 nus-ch-s1r1:9000 check
    server nus-ch-s1r2 nus-ch-s1r2:9000 check
    server nus-ch-s2r1 nus-ch-s2r1:9000 check
    server nus-ch-s2r2 nus-ch-s2r2:9000 check

# Grafana (f-infra-grafana) ---------------------------------------------------
# A single backend, so this is only an entry point, not load balancing: it
# gives Grafana one address that stays the same whichever proxy is in use.

listen grafana
    bind :3000
    server nus-grafana nus-grafana:3000 check

# Superset (g-infra-superset) -------------------------------------------------
# One backend again: the proxy is the single address, not a balancer. The
# check asks for /health, which Superset answers without a login.

listen superset
    bind :8088
    option httpchk
    http-check send meth GET uri /health
    http-check expect status 200
    server nus-superset nus-superset:8088 check
