# nus-lb-a — one HAProxy. It publishes a stable host port for each store.
# Each backend is the one process behind that port. Backends resolve through
# Docker's embedded DNS (127.0.0.11) with init-addr none, so HAProxy starts
# cleanly even while a backend's container does not exist yet.
#
# THIS IS A TEMPLATE, not the file HAProxy reads. __REDIS_PASSWORD__ below
# is filled in by the render-haproxy-config one-shot before lb-a starts
# (HAProxy does not expand ${VAR} from its own environment inside a
# tcp-check string — confirmed, not assumed) — see
# z-config/haproxy/render-config.sh. Never put a real password in this
# file; it is committed.

global
    log stdout format raw local0 info
    maxconn 4096

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client 30m
    timeout server 30m
    default-server resolvers docker init-addr last,libc,none inter 3s fall 3 rise 2

resolvers docker
    nameserver dns1 127.0.0.11:53
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s
    hold valid 10s
    hold other 10s
    hold refused 10s
    hold nx 10s
    hold timeout 10s
    hold obsolete 10s

# Stats / observability ------------------------------------------------------
listen stats
    mode http
    bind :8404
    stats enable
    stats uri /stats
    stats refresh 10s

# PostgreSQL (a-infra-postgres) ----------------------------------------------
# One database. Both ports are that process, so a client that still uses
# the read port reaches the writer. Debezium uses the write port.

listen pg_write
    bind :5432
    option tcp-check
    server nus-postgres nus-postgres:5432 check

listen pg_read
    bind :5433
    option tcp-check
    server nus-postgres nus-postgres:5432 check

# Redis (b-infra-redis) --------------------------------------------------------
# One Redis. Both host ports are that same node, so an existing read-port
# client still lands somewhere that answers. REDIS_PASSWORD must not contain
# whitespace: AUTH is sent as a raw inline Redis command, which splits on spaces.

listen redis_write
    bind :6379
    option tcp-check
    tcp-check send AUTH\ __REDIS_PASSWORD__\r\n
    tcp-check expect string +OK
    tcp-check send PING\r\n
    tcp-check expect string +PONG
    tcp-check send QUIT\r\n
    tcp-check expect string +OK
    default-server on-marked-down shutdown-sessions
    server nus-redis nus-redis:6379 check

listen redis_read
    bind :6380
    option tcp-check
    tcp-check send AUTH\ __REDIS_PASSWORD__\r\n
    tcp-check expect string +OK
    tcp-check send PING\r\n
    tcp-check expect string +PONG
    tcp-check send QUIT\r\n
    tcp-check expect string +OK
    default-server on-marked-down shutdown-sessions
    server nus-redis nus-redis:6379 check

# Kafka (c-infra-kafka) --------------------------------------------------------
# One broker. A client is told the address baked into advertised.listeners,
# so HAProxy only publishes that address. Two ports because this host can
# have two network paths, and a broker advertises one address per listener.

listen kafka-a
    bind :9094
    server nus-kafka nus-kafka:9094 check

listen kafka-b
    bind :9097
    server nus-kafka nus-kafka:9095 check

# ksqlDB reads the one broker as SQL. DBeaver's Kafka support speaks this
# REST API, not the raw broker protocol. The healthcheck must send Basic
# auth or every probe gets 401. __KSQLDB_BASIC_AUTH__ is base64(user:pass),
# filled in by render-config.sh.

listen ksqldb
    bind :8089
    option httpchk
    http-check send meth GET uri /info hdr Authorization "Basic __KSQLDB_BASIC_AUTH__"
    http-check expect status 200
    server nus-ksqldb-server nus-ksqldb-server:8088 check

# Debezium Connect (d-infra-debezium) ------------------------------------------
# One backend, no authentication (Connect's REST API has none, and the raw
# Kafka ports it depends on have none either - same trust model as ksqlDB's
# own underlying cluster, just without ksqlDB's one login). The check mirrors
# Connect's own container healthcheck: GET / answers 200 once it is actually
# serving, not merely running - this image scans every bundled connector
# plugin before it opens the REST port, which is measured to take minutes,
# not seconds.

listen debezium
    bind :8083
    option httpchk
    http-check send meth GET uri /
    http-check expect status 200
    server nus-debezium-connect nus-debezium-connect:8083 check

# ClickHouse (e-infra-clickhouse) ---------------------------------------------
# One server. The HTTP check asks for /ping, which answers "Ok." without
# a login. The native port is checked by opening a connection.

listen ch_http
    bind :8123
    option httpchk
    http-check send meth GET uri /ping
    http-check expect status 200
    server nus-clickhouse nus-clickhouse:8123 check

listen ch_native
    bind :9000
    server nus-clickhouse nus-clickhouse:9000 check

# Grafana (f-infra-grafana) + self-hosted OSM tiles ---------------------------
# Same origin as Grafana so the browser never talks to MapTiler. HTTP mode
# is required for the path split; timeout tunnel keeps Grafana websockets
# alive and lives on grafana_be — a frontend has no backend capability, so
# HAProxy ignores it here and warns on every start ("'timeout tunnel' will
# be ignored because frontend 'grafana_fe' has no backend capability").
#
# Strip /tiles/ on the tiles BACKEND, not here. HAProxy evaluates
# use_backend AFTER http-request rules, so a frontend replace-path
# made path_beg /tiles/ false and every tile went to Grafana (302/404).

frontend grafana_fe
    bind :3000
    mode http
    option httplog
    option http-keep-alive
    acl is_tiles path_beg /tiles/
    use_backend tiles if is_tiles
    default_backend grafana_be

backend grafana_be
    mode http
    option http-keep-alive
    timeout tunnel 1h
    server nus-grafana nus-grafana:3000 check

backend tiles
    mode http
    timeout server 60s
    http-request replace-path ^/tiles/(.*) /\1
    option httpchk
    http-check send meth GET uri /
    http-check expect status 200
    server nus-tiles nus-tiles:8080 check

# Superset (g-infra-superset) -------------------------------------------------
# One backend again: the proxy is the single address, not a balancer. The
# check asks for /health, which Superset answers without a login.

listen superset
    bind :8088
    option httpchk
    http-check send meth GET uri /health
    http-check expect status 200
    server nus-superset nus-superset:8088 check
