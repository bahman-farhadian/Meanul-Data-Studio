# k-service-passenger settings.
# Copy to .env (untracked):  cp .env.example .env

TZ=UTC
LOG_LEVEL=INFO

# Kafka and the Schema Registry (piece c)
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
PASSENGER_GROUP_ID=passenger-service

# Redis (piece b) — password must match b-infra-redis/.env
REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
REDIS_MASTER_NAME=nus-cache
REDIS_PASSWORD=change-me-redis

# PostgreSQL (piece a) — password must match a-infra-postgres/.env
PG_HOST=lb-a
PG_WRITE_PORT=5432
PG_READ_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=change-me

# The city. Must be the same everywhere, or two components would draw
# different maps and disagree about which zone a point is in.
CITY_MIN_LAT=40.49
CITY_MAX_LAT=40.92
CITY_MIN_LON=-74.26
CITY_MAX_LON=-73.70
CITY_GRID_ROWS=6
CITY_GRID_COLS=6

# --- How much demand there is -----------------------------------------------
# The second volume dial of the stack, after driver-service's tick. Every
# request becomes a routing calculation in dispatch-service, which is the
# most expensive single step anywhere in the pipeline.
#
# The rate below is the average for an ordinary hour. Busy hours multiply it
# (up to about twice), quiet night hours cut it to a fraction.
PASSENGER_TICK_SECONDS=5.0
TRIP_REQUESTS_PER_MINUTE=40.0

# Same seed, same stream of requests - a run that can be repeated can be
# debugged.
RANDOM_SEED=20250824
