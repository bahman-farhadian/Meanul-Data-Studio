        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Latest demand by zone",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "description": "",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    zone_id,\n    demand_score,\n    open_requests,\n    available_drivers,\n    surge_multiplier,\n    period,\n    last_computed\nFROM (\n    SELECT\n        zone_id,\n        argMax(demand_score, computed_at) AS demand_score,\n        argMax(open_requests, computed_at) AS open_requests,\n        argMax(available_drivers, computed_at) AS available_drivers,\n        argMax(surge_multiplier, computed_at) AS surge_multiplier,\n        argMax(period, computed_at) AS period,\n        max(computed_at) AS last_computed\n    FROM nus.hotspot_history\n    WHERE computed_at >= now() - INTERVAL 10 MINUTE\n    GROUP BY zone_id\n) AS latest\nORDER BY demand_score DESC\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Demand score (selected zone)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT computed_at AS time, demand_score, surge_multiplier\nFROM nus.hotspot_history\nWHERE zone_id = '${zone_id}'\n  AND $__timeFilter(computed_at)\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
