  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "zone_id",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "nus-clickhouse"
        },
        "definition": "SELECT DISTINCT toString(zone_id) FROM nus.hotspot_history WHERE computed_at >= now() - INTERVAL 1 HOUR ORDER BY 1 LIMIT 300",
        "query": "SELECT DISTINCT toString(zone_id) FROM nus.hotspot_history WHERE computed_at >= now() - INTERVAL 1 HOUR ORDER BY 1 LIMIT 300",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 0,
        "regex": "",
