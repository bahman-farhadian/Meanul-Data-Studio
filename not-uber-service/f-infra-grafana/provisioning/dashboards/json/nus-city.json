        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT computed_at AS time, congestion_factor, speed_samples, segments_updated\nFROM nus.segment_traffic_history\nWHERE zone_id = '${zone_id}'\n  AND $__timeFilter(computed_at)\nORDER BY time\n",
          "refId": "A",
