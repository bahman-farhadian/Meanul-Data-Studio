{
  "uid": "nus-live-ops",
  "title": "NUS / Live operations",
  "description": "What is happening now: open trips, ingest, last driver positions, warehouse freshness. ClickHouse only.",
  "tags": [
    "nus",
    "live"
  ],
  "timezone": "America/New_York",
  "schemaVersion": 39,
  "version": 10,
  "refresh": "10s",
  "liveNow": true,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Open trips by last status",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT status, count() AS trips\nFROM (\n    SELECT trip_id, argMax(status, event_time) AS status\n    FROM nus.trip_events\n    WHERE event_time >= now() - INTERVAL 6 HOUR\n    GROUP BY trip_id\n)\nWHERE status IN ('requested', 'matched', 'accepted', 'en_route_pickup', 'in_progress')\nGROUP BY status\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "trip_events lag (seconds behind now)",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT dateDiff('second', max(event_time), now()) AS lag_s\nFROM nus.trip_events\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "driver_positions lag (seconds behind now)",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT dateDiff('second', max(event_time), now()) AS lag_s\nFROM nus.driver_positions\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Trip events per minute",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n    $__timeInterval(event_time) AS time,\n    count() AS events\nFROM nus.trip_events\nWHERE $__timeFilter(event_time)\nGROUP BY time\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Driver positions per minute",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n    $__timeInterval(event_time) AS time,\n    count() AS events\nFROM nus.driver_positions\nWHERE $__timeFilter(event_time)\nGROUP BY time\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Completes / no-driver / cancels",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n    $__timeInterval(event_time) AS time,\n    status,\n    count() AS events\nFROM nus.trip_events\nWHERE $__timeFilter(event_time)\n  AND status IN ('completed', 'no_driver_found', 'cancelled_by_passenger', 'cancelled_by_driver')\nGROUP BY time, status\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Last driver positions (2 minutes)",
      "type": "geomap",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 12,
        "w": 14,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    driver_id,\n    argMax(lat, event_time) AS lat,\n    argMax(lon, event_time) AS lon,\n    argMax(status, event_time) AS status,\n    max(event_time) AS last_seen\nFROM nus.driver_positions\nWHERE event_time >= now() - INTERVAL 2 MINUTE\nGROUP BY driver_id\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "allLayers": true,
          "id": "coords",
          "lat": 40.75,
          "lon": -73.98,
          "zoom": 11
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "xyz",
          "name": "NUS OSM",
          "config": {
            "url": "/tiles/styles/nus/{z}/{x}/{y}.png",
            "attribution": "\u00a9 OpenStreetMap"
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Drivers",
            "config": {
              "style": {
                "size": {
                  "fixed": 7,
                  "min": 3,
                  "max": 12
                },
                "color": {
                  "fixed": "dark-green"
                },
                "opacity": 0.9,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "tooltip": true
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "In-progress trips",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 12,
        "w": 10,
        "x": 14,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    trip_id,\n    argMax(driver_id, event_time) AS driver_id,\n    argMax(rider_id, event_time) AS rider_id,\n    argMax(pickup_zone_id, event_time) AS pickup_zone,\n    argMax(dropoff_zone_id, event_time) AS dropoff_zone,\n    argMax(predicted_duration_s, event_time) AS predicted_s,\n    argMax(fare_estimate, event_time) AS fare_estimate,\n    max(event_time) AS last_event\nFROM nus.trip_events\nWHERE event_time >= now() - INTERVAL 6 HOUR\nGROUP BY trip_id\nHAVING argMax(status, event_time) = 'in_progress'\nORDER BY last_event DESC\nLIMIT 100\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Fleet last status (2 minutes)",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT status, count() AS drivers\nFROM (\n    SELECT driver_id, argMax(status, event_time) AS status\n    FROM nus.driver_positions\n    WHERE event_time >= now() - INTERVAL 2 MINUTE\n    GROUP BY driver_id\n)\nGROUP BY status\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
