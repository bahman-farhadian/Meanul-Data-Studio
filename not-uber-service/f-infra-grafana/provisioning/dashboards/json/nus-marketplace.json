    {
      "id": 10,
      "title": "Offers per accepted match",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "description": "How many drivers dispatch had to ask before one took the ride. Rising means the chain is working harder for the same trip, which is the earliest visible sign of thin supply - well before fulfilment falls.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n    hour AS time,\n    sum(offers_made) / sum(offers_accepted) AS offers_per_match\nFROM nus.dispatch_funnel_hourly\nWHERE $__timeFilter(hour)\nGROUP BY hour\nHAVING sum(offers_accepted) > 0\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
