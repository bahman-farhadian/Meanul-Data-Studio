    {
      "id": 12,
      "title": "Does surge lift acceptance",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "description": "The question surge exists to answer. Bucketed at the OFFER, using the multiplier that was in force when the driver was asked - not recomputed later. A flat line across the bands means surge is not buying supply, whatever the price says.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    multiIf(surge_multiplier < 1.05, '1.00 (flat)',\n            surge_multiplier < 1.25, '1.05 - 1.25',\n            surge_multiplier < 1.50, '1.25 - 1.50',\n            surge_multiplier < 2.00, '1.50 - 2.00',\n                                     '2.00 +')       AS surge_band,\n    countIf(status = 'accepted') / count()           AS acceptance_rate\nFROM nus.dispatch_offers\nWHERE $__timeFilter(offered_at)\n  AND surge_multiplier IS NOT NULL\nGROUP BY surge_band\nHAVING count() > 0\nORDER BY surge_band\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 13,
      "title": "Duration error: actual minus predicted",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "description": "pgRouting promises a duration before the trip starts; this is what it cost. Zero is a perfect promise and positive means the traffic model is behind the street. Cast to Int64 before subtracting: both columns are unsigned, and an unsigned difference wraps a small early arrival into four billion seconds. No FINAL here on purpose - a duplicate shifts a quantile by nothing, and FINAL over a raw table every hour is not free.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n    toStartOfHour(ended_at) AS time,\n    quantile(0.5)(toInt64(actual_duration_s) - toInt64(predicted_duration_s))\n        AS p50_error_s,\n    quantile(0.9)(toInt64(actual_duration_s) - toInt64(predicted_duration_s))\n        AS p90_error_s\nFROM nus.trip_facts\nWHERE $__timeFilter(event_time)\n  AND final_status = 'completed'\n  AND predicted_duration_s IS NOT NULL\n  AND actual_duration_s IS NOT NULL\nGROUP BY time\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50_error_s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p90_error_s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Where demand goes unserved",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "description": "Worst zone first, because that is the one to act on. The HAVING floor keeps a zone with three requests and one failure off the top of the list - at 25 zones deep, small denominators are the only way to get noise up here.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    pickup_zone_id,\n    sum(trips_ended)                       AS requests,\n    sum(completed) / sum(trips_ended)      AS fulfilment_rate,\n    sum(no_driver_found) / sum(trips_ended) AS no_driver_rate,\n    sum(match_s_sum) / sum(matched_trips)  AS time_to_match_s\nFROM nus.fulfilment_hourly\nWHERE $__timeFilter(hour)\nGROUP BY pickup_zone_id\nHAVING sum(trips_ended) >= 20 AND sum(matched_trips) > 0\nORDER BY fulfilment_rate ASC\nLIMIT 25\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fulfilment_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.8
                    },
                    {
                      "color": "green",
                      "value": 0.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "no_driver_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time_to_match_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    }
