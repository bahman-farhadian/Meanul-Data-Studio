    {
      "id": 11,
      "title": "Pickup ETA: every offer vs the accepted one",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nus-clickhouse"
      },
      "description": "Both in seconds, so one axis is honest. Read the GAP, not the levels: dispatch offers nearest-first, so the driver who accepts is by construction among the furthest asked, and the accepted line sitting above the offered line is the chain working as designed rather than a fault.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nus-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n    hour AS time,\n    sum(eta_seconds_sum) / sum(eta_offers)      AS eta_offered_s,\n    sum(accepted_eta_sum) / sum(offers_accepted) AS eta_accepted_s\nFROM nus.dispatch_funnel_hourly\nWHERE $__timeFilter(hour)\nGROUP BY hour\nHAVING sum(eta_offers) > 0 AND sum(offers_accepted) > 0\nORDER BY time\n",
          "refId": "A",
          "pluginVersion": "4.21.2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
