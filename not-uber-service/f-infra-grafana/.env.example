# f-infra-grafana settings.
# Copy to .env (untracked) and change the passwords:  cp .env.example .env

# Everything in the stack runs in UTC (see the root README)
TZ=UTC

# Pinned image and plugin version. The plugin is baked into the image at
# build time, so starting Grafana needs no internet access.
GRAFANA_IMAGE=grafana/grafana:11.6.0
GRAFANA_CLICKHOUSE_PLUGIN_VERSION=4.5.1

# The Grafana login — CHANGE THE PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# How Grafana logs in to ClickHouse. Must match CH_USER / CH_PASSWORD in
# e-infra-clickhouse/.env
CH_USER=nus
CH_PASSWORD=change-me-clickhouse
