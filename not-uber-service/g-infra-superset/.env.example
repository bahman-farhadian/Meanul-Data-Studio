# g-infra-superset settings.
# Copy to .env (untracked) and change every secret:  cp .env.example .env

# Everything in the stack runs in UTC (see the root README)
TZ=UTC

# Pinned image and driver version. The ClickHouse driver is installed into
# the image at build time, so the container needs no internet to run.
SUPERSET_IMAGE=apache/superset:4.1.1
CLICKHOUSE_CONNECT_VERSION=0.8.15

# Signs session cookies and encrypts the saved database password.
# CHANGE THIS. Changing it later logs everyone out and makes Superset unable
# to read back the ClickHouse password it stored - re-run superset-init then.
# Generate one with:  openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-superset-secret

# The Superset login — CHANGE THE PASSWORD
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset
SUPERSET_ADMIN_EMAIL=admin@example.invalid

# How Superset reaches ClickHouse. The user and password must match
# e-infra-clickhouse/.env; the host is the entry tier, not a single node.
CH_HOST=lb-a
CH_HTTP_PORT=8123
CH_DATABASE=nus
CH_USER=nus
CH_PASSWORD=change-me-clickhouse
