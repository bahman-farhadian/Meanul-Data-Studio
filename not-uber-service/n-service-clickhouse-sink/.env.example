# n-service-clickhouse-sink settings.
# Copy to .env (untracked):  cp .env.example .env

TZ=UTC
LOG_LEVEL=INFO

# Kafka and the Schema Registry (piece c)
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
SINK_GROUP_ID=clickhouse-sink

# Redis (piece b) — used for enrichment only. Password must match
# b-infra-redis/.env
REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
REDIS_MASTER_NAME=nus-cache
REDIS_PASSWORD=change-me-redis

# ClickHouse (piece e) — password must match e-infra-clickhouse/.env
CH_HOST=lb-a
CH_HTTP_PORT=8123
CH_DATABASE=nus
CH_USER=nus
CH_PASSWORD=change-me-clickhouse

# --- Batching ---------------------------------------------------------------
# ClickHouse rewards large inserts and punishes small ones: every insert
# creates a part that later has to be merged away.
#
# Rows go when either limit is reached. The time limit matters as much as the
# size: at three in the morning a batch might take minutes to fill, and a
# dashboard should not be minutes behind.
SINK_BATCH_ROWS=5000
SINK_FLUSH_SECONDS=5.0

# Demand scores are read once and reused, rather than looked up per message.
# They only change every half minute anyway.
SINK_HOTSPOT_REFRESH_SECONDS=30.0

# The score at which a trip counts as a hotspot trip.
HOTSPOT_SCORE_THRESHOLD=0.6
