# i-service-cache-updater settings.
# Copy to .env (untracked):  cp .env.example .env

TZ=UTC
LOG_LEVEL=INFO

# Kafka and the Schema Registry (piece c)
KAFKA_BOOTSTRAP=nus-kafka:9092
SCHEMA_REGISTRY_URL=http://nus-schema-registry:8081
CACHE_UPDATER_GROUP_ID=cache-updater
# Every topic Debezium creates. A pattern, so a newly captured table is
# picked up without editing anything here.
CDC_TOPIC_PATTERN=^cdc\..*

# Redis (piece b) — the password must match b-infra-redis/.env
REDIS_HOST=nus-redis
REDIS_PASSWORD=change-me-redis

# Changes are collected and written together. Larger batches are faster and
# repeat more work after a crash; these values keep both small.
CACHE_BATCH_SIZE=500
CACHE_FLUSH_SECONDS=2.0
